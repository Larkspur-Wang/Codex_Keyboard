{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Keyboard",
  "version": "0.1.0",
  "identifier": "com.larkspur.easy-codex-input",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Keyboard",
        "width": 680,
        "height": 460,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
